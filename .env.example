# Copia este archivo como .env y completa los datos (el .env no se sube a git).
# Gmail: activa la verificacion en 2 pasos y crea una contrasena de aplicacion en
# https://myaccount.google.com/apppasswords (16 caracteres, sin espacios).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_cuenta@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
# Opcional: remitente que vera el solicitante (por defecto MAIL_USERNAME)
MAIL_FROM=

# Base de datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=tu_contrasena_de_postgres

# Clave para firmar los tokens JWT (Base64, minimo 32 bytes). Genera una propia con:
#   openssl rand -base64 64
JWT_SECRET=pega_aqui_la_clave_generada
